# Copiar como .env y cambiar TODAS las claves. El .env nunca se sube a GitHub.

# --- Usuarios del broker MQTT ---
MQTT_USER_ESP32=esp32
MQTT_PASS_ESP32=cambiar-clave-esp32
MQTT_USER_SERVICIOS=servicios
MQTT_PASS_SERVICIOS=cambiar-clave-servicios

# --- InfluxDB y Grafana ---
INFLUX_PASSWORD=cambiar-clave-influx
INFLUX_TOKEN=cambiar-token-largo-influx
GRAFANA_PASSWORD=cambiar-clave-grafana

# --- Telegram (alarmas). Crear el bot con @BotFather y el chat id con @userinfobot ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reglas de alarma (opcional; estos son los valores por defecto) ---
RANGO_TEMP=15,25
RANGO_HUM=50,65
UMBRAL_VENTILADOR=0.60
VENTANAS_VENTILADOR=3
UMBRAL_VISION=0.70
VISION_CLASES_ALERTA=moho,broca,defecto
SILENCIO_SEG=60
REAVISO_MIN=5
